<%# ============================================ %>
<%# カレンダー画面 %>
<%# 月間カレンダーを表示する %>
<%# 集中セッションが記録された日にスカイブルーの達成マークを付ける %>
<%# 日付の下に合計学習時間を表示する %>
<%# 締め切りのあるタスクを日付に表示する %>
<%# ============================================ %>

<%# 色名とTailwindクラスのマッピング（ERBで使う） %>
<% cal_color_map = {
  'sky'     => { dot: 'bg-sky-400',     text: 'text-sky-400' },
  'violet'  => { dot: 'bg-violet-400',  text: 'text-violet-400' },
  'rose'    => { dot: 'bg-rose-400',    text: 'text-rose-400' },
  'amber'   => { dot: 'bg-amber-400',   text: 'text-amber-400' },
  'emerald' => { dot: 'bg-emerald-400', text: 'text-emerald-400' },
  'orange'  => { dot: 'bg-orange-400',  text: 'text-orange-400' },
} %>

<%# ---- カレンダーの日付範囲を計算 ---- %>
<% first_day  = Date.new(@year, @month, 1) %>
<% last_day   = first_day.end_of_month %>
<% start_date = first_day - first_day.wday %>
<% end_date   = last_day + (6 - last_day.wday) %>

<%# 今日の日付（当日ハイライト用） %>
<% today = Date.today %>

<%# 曜日ラベル（日曜始まり） %>
<% wday_labels = %w[日 月 火 水 木 金 土] %>

<div class="min-h-screen py-8">

  <%# ---- ヘッダーナビゲーション ---- %>
  <div class="navbar bg-base-200 rounded-2xl shadow-lg mb-8 px-4">

    <div class="navbar-start">
      <span class="text-xl font-black tracking-tight">
        <span class="text-sky-400">up</span><span class="text-white">stairs</span>
      </span>
    </div>

    <div class="navbar-center">
      <span class="text-base-content/70 text-sm font-medium flex items-center gap-1">
        <i class="ph-fill ph-user-circle text-sky-400 text-lg"></i>
        <%= @user.username %> の達成カレンダー
      </span>
    </div>

    <div class="navbar-end flex items-center gap-2">
      <a href="/mypage" class="btn btn-ghost btn-sm flex items-center gap-1 text-sky-400">
        <i class="ph ph-list-checks text-lg"></i>
        マイページ
      </a>
      <form action="/logout" method="post">
        <button type="submit" class="btn btn-ghost btn-sm flex items-center gap-1 text-base-content/50 hover:text-white">
          <i class="ph ph-sign-out text-lg"></i>
          ログアウト
        </button>
      </form>
    </div>
  </div>

  <%# ---- メインコンテンツ ---- %>
  <div class="max-w-3xl mx-auto">

    <%# ---- 月ナビゲーションと見出し ---- %>
    <div class="flex items-center justify-between mb-6">
      <a href="/calendar?year=<%= @prev_month.year %>&month=<%= @prev_month.month %>"
         class="btn btn-ghost btn-sm flex items-center gap-1 text-sky-400">
        <i class="ph ph-caret-left text-xl"></i>
        <span class="hidden sm:inline"><%= @prev_month.year %>年<%= @prev_month.month %>月</span>
      </a>

      <h1 class="text-3xl font-bold flex items-center gap-2">
        <i class="ph-fill ph-calendar-check text-sky-400"></i>
        <%= @year %>年<%= @month %>月
      </h1>

      <a href="/calendar?year=<%= @next_month.year %>&month=<%= @next_month.month %>"
         class="btn btn-ghost btn-sm flex items-center gap-1 text-sky-400">
        <span class="hidden sm:inline"><%= @next_month.year %>年<%= @next_month.month %>月</span>
        <i class="ph ph-caret-right text-xl"></i>
      </a>
    </div>

    <%# ---- カレンダー本体 ---- %>
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body p-4">

        <%# 曜日ヘッダー（7列） %>
        <div class="grid grid-cols-7 mb-2">
          <% wday_labels.each_with_index do |label, i| %>
            <div class="text-center text-xs font-bold py-2
              <%= i == 0 ? 'text-red-400' : i == 6 ? 'text-sky-400' : 'text-base-content/50' %>">
              <%= label %>
            </div>
          <% end %>
        </div>

        <%# 日付グリッド %>
        <div class="grid grid-cols-7 gap-1" id="calendar-grid">

          <% current = start_date %>
          <% while current <= end_date %>

            <%# この日の集中セッション配列を取得 %>
            <% sessions = @calendar[current] || [] %>
            <%# この日の締め切りタスクを取得 %>
            <% due_tasks = @due_tasks_by_date ? (@due_tasks_by_date[current] || []) : [] %>
            <% in_current_month = (current.month == @month) %>
            <% is_today = (current == today) %>
            <% has_sessions = sessions.any? %>

            <%# この日の合計学習時間（分）を計算する %>
            <% total_minutes = sessions.sum(&:duration_minutes) %>

            <%# セッション情報を JSON で data 属性に埋め込む（色も含める） %>
            <% sessions_json = sessions.map { |s|
              {
                task_name:        s.task.name,
                duration_minutes: s.duration_minutes,
                color:            s.task.effective_color
              }
            }.to_json %>

            <%# 締め切りタスク情報を JSON で埋め込む（色も含める） %>
            <% due_tasks_json = due_tasks.map { |t|
              { task_name: t.name, color: t.effective_color }
            }.to_json %>

            <%# 日付セル %>
            <div
              class="relative flex flex-col items-center justify-start pt-1 pb-1 rounded-lg min-h-[4rem]
                <%= (has_sessions || due_tasks.any?) ? 'cursor-pointer hover:bg-sky-400/10 transition-colors' : '' %>
                <%= is_today ? 'ring-1 ring-sky-400' : '' %>
                <%= in_current_month ? '' : 'opacity-25' %>"
              <% if has_sessions || due_tasks.any? %>
                data-date="<%= current.strftime('%Y-%m-%d') %>"
                data-sessions="<%= ERB::Util.html_escape(sessions_json) %>"
                data-due-tasks="<%= ERB::Util.html_escape(due_tasks_json) %>"
                data-label="<%= current.year %>年<%= current.month %>月<%= current.day %>日"
                onclick="showDetail(this)"
              <% end %>
            >

              <%# 日付の数字 %>
              <span class="text-sm font-semibold leading-none mb-0.5
                <%= current.wday == 0 ? 'text-red-400' : current.wday == 6 ? 'text-sky-400' : 'text-base-content' %>
                <%= is_today ? 'text-sky-400 font-black' : '' %>">
                <%= current.day %>
              </span>

              <%# 達成マーク: タスクごとに色付きドットを並べる %>
              <% if has_sessions %>
                <%# タスクごとにまとめて色ドットを表示する %>
                <div class="flex flex-wrap gap-0.5 justify-center mb-0.5">
                  <% sessions.group_by { |s| s.task_id }.each do |_, task_sessions| %>
                    <% col = cal_color_map[task_sessions.first.task.effective_color] || cal_color_map['sky'] %>
                    <span class="w-1.5 h-1.5 rounded-full <%= col[:dot] %> block"></span>
                  <% end %>
                </div>
                <%# 合計学習時間を表示する（60分以上は時間で表示） %>
                <span class="text-xs font-bold text-sky-400 leading-none">
                  <% if total_minutes >= 60 %>
                    <%= total_minutes / 60 %>h<%= total_minutes % 60 > 0 ? "#{total_minutes % 60}m" : "" %>
                  <% else %>
                    <%= total_minutes %>m
                  <% end %>
                </span>
              <% end %>

              <%# 締め切りタスクマーク: タスクごとに色付きドット %>
              <% if due_tasks.any? %>
                <div class="flex flex-wrap gap-0.5 justify-center <%= has_sessions ? '' : 'mb-0.5' %>">
                  <% due_tasks.each do |dt| %>
                    <% col = cal_color_map[dt.effective_color] || cal_color_map['sky'] %>
                    <span class="w-1.5 h-1.5 rounded-full <%= col[:dot] %> opacity-70 block" title="<%= dt.name %>"></span>
                  <% end %>
                </div>
              <% end %>

            </div>

            <% current += 1 %>
          <% end %>

        </div>

      </div>
    </div>

    <%# ---- 凡例 ---- %>
    <div class="flex flex-wrap items-center gap-4 mt-4 px-2 text-xs text-base-content/50">
      <span class="flex items-center gap-1">
        <span class="w-2 h-2 rounded-full bg-sky-400 inline-block"></span>
        集中セッションの記録あり
      </span>
      <span class="flex items-center gap-1">
        <span class="text-sky-400 font-bold text-xs">25m</span>
        合計学習時間
      </span>
      <span class="flex items-center gap-1">
        <span class="w-2 h-2 rounded-full bg-warning inline-block"></span>
        締め切りのあるタスクあり
      </span>
      <span class="flex items-center gap-1">
        <span class="w-4 h-4 rounded ring-1 ring-sky-400 inline-flex items-center justify-center text-sky-400 font-black text-xs">今</span>
        今日
      </span>
    </div>

    <%# ---- 詳細パネル（日付クリック時に表示） ---- %>
    <div id="session-detail" class="hidden mt-6">
      <div class="card bg-base-200 border border-sky-400/30 shadow-xl">
        <div class="card-body gap-4 py-5 px-6">

          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold flex items-center gap-2">
              <i class="ph-fill ph-calendar-check text-sky-400 text-lg"></i>
              <span id="detail-date-label">選択した日の記録</span>
            </h2>
            <button onclick="closeDetail()" class="btn btn-ghost btn-xs text-base-content/40 hover:text-white">
              <i class="ph ph-x text-base"></i>
            </button>
          </div>

          <%# 集中セッション一覧 %>
          <div id="detail-sessions-section" class="hidden">
            <p class="text-xs text-base-content/50 font-semibold mb-2 flex items-center gap-1">
              <i class="ph-fill ph-timer text-sky-400"></i>
              集中セッション
            </p>
            <ul id="detail-sessions-list" class="flex flex-col gap-2"></ul>
          </div>

          <%# 締め切りタスク一覧 %>
          <div id="detail-due-tasks-section" class="hidden">
            <p class="text-xs text-base-content/50 font-semibold mb-2 flex items-center gap-1">
              <i class="ph-fill ph-calendar text-warning"></i>
              この日が締め切りのタスク
            </p>
            <ul id="detail-due-tasks-list" class="flex flex-col gap-2"></ul>
          </div>

        </div>
      </div>
    </div>

    <%# ---- 集中記録がない月向けの空状態メッセージ ---- %>
    <% if @calendar.empty? && (@due_tasks_by_date.nil? || @due_tasks_by_date.empty?) %>
      <div class="mt-6 card bg-base-200 shadow">
        <div class="card-body items-center text-center py-10 gap-3">
          <i class="ph ph-timer text-sky-400/40 text-5xl"></i>
          <p class="text-base-content/50 text-sm">
            この月の集中記録はまだありません。<br>
            タスクを選んで集中タイマーをスタートしましょう。
          </p>
          <a href="/mypage" class="btn btn-info btn-sm font-bold text-white mt-1 gap-1">
            <i class="ph-fill ph-timer text-base"></i>
            タスク一覧へ
          </a>
        </div>
      </div>
    <% end %>

  </div>
</div>

<%# ---- JavaScript: 日付クリック時の詳細表示 ---- %>
<script>
  function showDetail(el) {
    var label      = el.getAttribute('data-label');
    var sessionsRaw = el.getAttribute('data-sessions') || '[]';
    var dueTasksRaw = el.getAttribute('data-due-tasks') || '[]';

    var sessions = [];
    var dueTasks = [];
    try { sessions = JSON.parse(sessionsRaw); } catch (e) {}
    try { dueTasks = JSON.parse(dueTasksRaw); } catch (e) {}

    document.getElementById('detail-date-label').textContent = label + ' の記録';

    // 集中セッション一覧を更新する
    var sessionSection = document.getElementById('detail-sessions-section');
    var sessionList = document.getElementById('detail-sessions-list');
    sessionList.innerHTML = '';

    if (sessions.length > 0) {
      sessionSection.classList.remove('hidden');
      var totalMin = 0;
      sessions.forEach(function(s) {
        totalMin += s.duration_minutes;
        var colorClass = colorTextClass(s.color || 'sky');
        var li = document.createElement('li');
        li.className = 'flex items-center gap-3 bg-base-300/60 rounded-lg px-4 py-3';
        li.innerHTML =
          '<i class="ph-fill ph-timer ' + colorClass + ' text-lg flex-shrink-0"></i>' +
          '<span class="flex-1 text-sm font-medium text-base-content">' + escapeHtml(s.task_name) + '</span>' +
          '<span class="text-xs font-bold ' + colorClass + ' flex-shrink-0">' + s.duration_minutes + ' 分</span>';
        sessionList.appendChild(li);
      });
      // 合計時間の行を追加する
      var totalLi = document.createElement('li');
      totalLi.className = 'flex items-center gap-3 px-4 py-1';
      var totalText = totalMin >= 60
        ? (Math.floor(totalMin / 60) + '時間' + (totalMin % 60 > 0 ? (totalMin % 60) + '分' : ''))
        : (totalMin + '分');
      totalLi.innerHTML =
        '<span class="flex-1 text-xs text-base-content/40 text-right">合計学習時間：</span>' +
        '<span class="text-sm font-black text-sky-400 flex-shrink-0">' + totalText + '</span>';
      sessionList.appendChild(totalLi);
    } else {
      sessionSection.classList.add('hidden');
    }

    // 締め切りタスク一覧を更新する
    var dueSection = document.getElementById('detail-due-tasks-section');
    var dueList = document.getElementById('detail-due-tasks-list');
    dueList.innerHTML = '';

    if (dueTasks.length > 0) {
      dueSection.classList.remove('hidden');
      dueTasks.forEach(function(t) {
        var li = document.createElement('li');
        li.className = 'flex items-center gap-3 bg-warning/10 rounded-lg px-4 py-3';
        li.innerHTML =
          '<i class="ph-fill ph-calendar text-warning text-lg flex-shrink-0"></i>' +
          '<span class="flex-1 text-sm font-medium text-base-content">' + escapeHtml(t.task_name) + '</span>';
        dueList.appendChild(li);
      });
    } else {
      dueSection.classList.add('hidden');
    }

    // パネルを表示する
    var panel = document.getElementById('session-detail');
    panel.classList.remove('hidden');

    // 選択した日のセルをハイライトする
    document.querySelectorAll('#calendar-grid [data-date]').forEach(function(cell) {
      cell.classList.remove('bg-sky-400/20', 'ring-1', 'ring-sky-400');
    });
    el.classList.add('bg-sky-400/20', 'ring-1', 'ring-sky-400');

    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function closeDetail() {
    document.getElementById('session-detail').classList.add('hidden');
    document.querySelectorAll('#calendar-grid [data-date]').forEach(function(cell) {
      cell.classList.remove('bg-sky-400/20', 'ring-1', 'ring-sky-400');
    });
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }
</script>
